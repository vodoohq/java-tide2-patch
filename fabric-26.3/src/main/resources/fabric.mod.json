  "authors": ["Lightning64", "soleilfenley (26.2 migration)", "VoodooHQ (26.3 port)"],
  "contact": {
    "homepage": "https://github.com/vodoohq/java-tide2-patch",
    "sources": "https://github.com/vodoohq/java-tide2-patch",
    "issues": "https://github.com/vodoohq/java-tide2-patch/issues"
  },
  "license": "MPL-2.0",
  "environment": "*",
  "entrypoints": {
    "main": ["com.li64.tide.loaders.fabric.FabricEntrypoint"],
    "client": ["com.li64.tide.loaders.fabric.FabricClientEntrypoint"],
    "modmenu": ["com.li64.tide.compat.modmenu.ModMenuCompat"]
